      {
        "component": "text",
        "name": "options",
        "label": "Options",
        "description": "For Radio / Checkbox / Dropdown only. List the choices separated by a pipe |  e.g.  Yes|No|Maybe . To store a different submitted value, use Label=value  e.g.  New Zealand=nz|Overseas=intl",
        "valueType": "string"
      },
